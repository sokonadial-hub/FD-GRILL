# Hostinger (LiteSpeed/Apache) settings for the built site

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # assets/.htaccess overrides this with a year for the fingerprinted files
  Header set Cache-Control "public, max-age=600"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
